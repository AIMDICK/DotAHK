<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DotAHK.OnboardingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DotAHK"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:DotAHK.ViewModels"
    mc:Ignorable="d">

    <Border
        MaxWidth="640"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12"
        Padding="32">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="6">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Loc.WelcomeTitle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.Loc.WelcomeBody}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListView
                Grid.Row="1"
                MaxHeight="320"
                ItemsSource="{x:Bind ViewModel.Folders}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:WatchFolderViewModel">
                        <CheckBox
                            HorizontalAlignment="Stretch"
                            Content="{x:Bind Path}"
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                Grid.Row="2"
                HorizontalAlignment="Left"
                Click="OnAddFolderClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                    <TextBlock Text="{x:Bind ViewModel.Loc.AddFolderText}" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="3"
                HorizontalAlignment="Right"
                Click="OnGetStartedClick"
                Content="{x:Bind ViewModel.Loc.GetStartedButton}"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Border>
</Page>
